# KudiVoice AI — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your REAL keys:
#     Windows PowerShell:  Copy-Item .env.example .env
# The real `.env` is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Groq API key (used as automatic fallback) — https://console.groq.com/keys
# (format: gsk_...)
GROQ_API_KEY=gsk_your-key-here
